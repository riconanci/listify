# Database (Neon.tech PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/listify?sslmode=require"

# Authentication
SESSION_SECRET="change-this-to-a-random-64-char-string"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Maps: CARTO basemap key. Without it the maps show an "API KEY REQUIRED"
# watermark. Request one at https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_KEY=""
